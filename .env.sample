PREFECT_WORKPOOL_TRANSFORM=transform
PREFECT_WORKPOOL_MERGE=merge

# Chunking Settings
MIN_SEMANTIC_CHUNK_SIZE=1000
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
CHUNKING_RETRIES=3
RETRY_DELAY_SECONDS=30

SUPABASE_URL=
SUPABASE_KEY=

# Storage Settings
STORAGE_BATCH_SIZE=1000
STORAGE_RETRIES=3

ENCRYPTION_MASTER_KEY=