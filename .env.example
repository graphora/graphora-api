# Graphora API environment template
# Copy to .env and fill in real values before running the service.

# Paths
ONTOLOGY_DIR=${HOME}/.graphora/ontologies
UPLOAD_DIR=${HOME}/.graphora/uploads

# API / Server
API_PORT=8000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info

# Local service ports (override if the defaults clash)
REDIS_PORT=6379

# External providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
VERTEXAI_PROJECT_ID=
VERTEXAI_LOCATION=us-central1
VERTEXAI_DEFAULT_MODEL=gemini-2.5-flash-lite-001

# Marker service
MARKER_API_HOST=http://127.0.0.1:8001
MARKER_API_TIMEOUT=120
MARKER_API_MAX_RETRIES=3
MARKER_API_BACKOFF_FACTOR=0.5
MARKER_API_USE_LLM=false
MARKER_API_PAGINATE=true

# Prefect
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_API_KEY=

# Chunking defaults
MAX_CHUNK_SIZE=60000
MIN_CHUNK_SIZE=15000
MAX_CHUNKS_PER_DOC=100
SEMANTIC_THRESHOLD=0.7
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
CHUNKING_RETRIES=3
RETRY_DELAY_SECONDS=30

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_HOURS=24
REDIS_DATA_SOURCE=./.docker-data/redis

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Application Postgres (used for configs, AI providers, etc.)
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphora
POSTGRES_USER=graphora
POSTGRES_PASSWORD=graphora
POSTGRES_DATA_SOURCE=./.docker-data/postgres
# Neo4j host bind mounts (override to move data/logs/import onto another disk)
NEO4J_STAGING_DATA_SOURCE=./.docker-data/neo4j-staging/data
NEO4J_STAGING_LOG_SOURCE=./.docker-data/neo4j-staging/logs
NEO4J_STAGING_IMPORT_SOURCE=./.docker-data/neo4j-staging/import
NEO4J_PROD_DATA_SOURCE=./.docker-data/neo4j-prod/data
NEO4J_PROD_LOG_SOURCE=./.docker-data/neo4j-prod/logs
NEO4J_PROD_IMPORT_SOURCE=./.docker-data/neo4j-prod/import
# Override used inside docker-compose (defaults to the local postgres container)
DOCKER_DATABASE_URL=

# Security
ENCRYPTION_MASTER_KEY=

# Clerk Authentication
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_API_KEY=
